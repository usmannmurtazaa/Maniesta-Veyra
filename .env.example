# ============================================================
# MANIESTA VEYRA — Environment Configuration
# ============================================================
# Copy this file to .env.local for local development.
# In production, set these values in your hosting provider's
# environment variable dashboard (e.g., Vercel).
# ============================================================

# ------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# ------------------------------------------------------------
# DATABASE_URL: used at runtime (via pgbouncer, transaction pooler)
# DIRECT_URL:   used for migrations and Prisma Studio
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ------------------------------------------------------------
# AUTHENTICATION (Auth.js / NextAuth v5)
# ------------------------------------------------------------
# Generate AUTH_SECRET with: openssl rand -base64 64
AUTH_SECRET="replace-me-with-a-64-char-random-string"
AUTH_URL=https://maniesta-veyra.netlify.app
NEXTAUTH_URL=https://maniesta-veyra.netlify.app

# ------------------------------------------------------------
# STORAGE (Vercel Blob)
# ------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------
# EMAIL (Resend)
# ------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="orders@maniestaveyra.com"

# ------------------------------------------------------------
# RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------
UPSTASH_REDIS_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_TOKEN="AXxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------
# PAYMENTS (Stripe — OPTIONAL)
# ------------------------------------------------------------
# If these are unset, ONLINE payment will not appear at checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# ------------------------------------------------------------
# PUBLIC APPLICATION CONFIG
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://maniesta-veyra.netlify.app
NEXT_PUBLIC_APP_NAME=Maniesta Veyra
NEXT_PUBLIC_APP_TAGLINE=Wear Your Identity.
NEXT_PUBLIC_PORTFOLIO_URL=https://usmanmurtaza.netlify.app

# ------------------------------------------------------------
# CURRENCY
# ------------------------------------------------------------
NEXT_PUBLIC_CURRENCY="PKR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₨"

# ------------------------------------------------------------
# ANALYTICS
# ------------------------------------------------------------
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------
# MONITORING (Sentry — OPTIONAL)
# ------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ------------------------------------------------------------
# CRON (Vercel cron authentication)
# ------------------------------------------------------------
CRON_SECRET="generate-with-openssl-rand-hex-32"

# ------------------------------------------------------------
# ADMIN BOOTSTRAP (used once, then remove/rotate)
# ------------------------------------------------------------
ADMIN_EMAIL="admin@maniestaveyra.com"
ADMIN_PASSWORD="change-me-before-first-run"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="User"